{
  "name": "svgin-element",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic <svg-in> custom element: securely fetch and inline SVGs from URLs, sanitized by default.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "node ../../scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "svgin-core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "svgin-eslint-config": "workspace:*",
    "svgin-tsup-config": "workspace:*",
    "svgin-typescript-config": "workspace:*",
    "svgin-vitest-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0"
  }
}
