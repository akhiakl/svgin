{
  "name": "svgin-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for svgin: securely fetch and inline SVGs from URLs, sanitized by default.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:test": "turbo run typecheck:test",
    "test": "turbo run test",
    "size": "turbo run size",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
